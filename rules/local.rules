# ==============================================================================
# PROJECT 2: NETWORK INTRUSION DETECTION (NIDS) & FORENSICS LAB
# Sensor: Suricata 8.0.8 (AF-PACKET, Promiscuous, Hardware Offloading Disabled)
# Author: leviathan | Cybersecurity Engineering Portfolio (CI1 -> M2 Alternance)
# File: /etc/suricata/rules/local.rules
# ==============================================================================

# ------------------------------------------------------------------------------
# ATTACK VECTOR 1: Nmap Stealth TCP SYN Half-Open Port Scan
# MITRE ATT&CK: T1046 (Network Service Discovery)
# OWASP: A02:2025 (Cryptographic Failures / Insecure Network Exposure)
# Technical Defense:
#   - flags:S,12 matches SYN=1, ignores CWR (bit 1) and ECE (bit 2) for ECN compatibility
#   - flow:stateless inspects raw un-established datagrams without waiting for 3-way handshake
#   - detection_filter tracks per-source burst rates (>20 SYNs in 5s) to eliminate false positives
# ------------------------------------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-ALERT - Potential Nmap TCP SYN Port Scan Detected"; flags:S,12; flow:stateless; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# ------------------------------------------------------------------------------
# ATTACK VECTOR 2: Obfuscated Base64-Encoded HTTP User-Agent (C2 / Web Shell)
# MITRE ATT&CK: T1071.001 (Application Layer Protocol: Web Protocols)
# OWASP: A05:2025 (Security Misconfiguration) & A09:2025 (Security Logging & Monitoring)
# Technical Defense:
#   - http.user_agent targets the parsed HTTP application-layer header buffer
#   - PCRE regex detects strings containing strictly Base64 alphabet >=30 chars with optional padding
#   - Matches covert communication channels and beaconing payloads hidden in User-Agent
# ------------------------------------------------------------------------------
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-ALERT - Obfuscated Base64 String in HTTP User-Agent (Possible C2)"; flow:established,to_server; http.user_agent; pcre:"/^[A-Za-z0-9+\/]{30,}={0,2}$/"; classtype:trojan-activity; sid:1000002; rev:1;)

# ------------------------------------------------------------------------------
# ATTACK VECTOR 3: Unauthorized Outbound SSH Egress Tunnel on Non-Standard Port
# MITRE ATT&CK: T1572 (Protocol Tunneling) & T1021.004 (SSH)
# OWASP: A01:2025 (Broken Access Control)
# Technical Defense:
#   - Egress filter: Destination port is NOT 22 (![22]), targeting perimeter evasion attempts
#   - Protocol validation: Inspects first 8 bytes for mandatory RFC 4253 banner "SSH-2.0-"
#   - flow:established,to_server tracks client initiation from inside $HOME_NET out to $EXTERNAL_NET
# ------------------------------------------------------------------------------
alert tcp $HOME_NET any -> $EXTERNAL_NET ![22] (msg:"SOC-ALERT - Suspicious Outbound SSH Tunnel on Non-Standard Port"; flow:established,to_server; content:"SSH-2.0-"; depth:8; classtype:bad-unknown; sid:1000003; rev:1;)

# ------------------------------------------------------------------------------
# ATTACK VECTOR 4: Cobalt Strike & Sliver HTTP C2 Stager / Beaconing Pattern
# MITRE ATT&CK: T1071.001 (Web Protocols) & T1041 (Exfiltration Over C2 Channel)
# OWASP: A08:2025 (Software & Data Integrity Failures)
# Technical Defense:
#   - Application layer inspection of GET requests
#   - Matches default Cobalt Strike stager 4-character checksum URIs or malleable C2 profiles
# ------------------------------------------------------------------------------
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-ALERT - Cobalt Strike / Sliver HTTP C2 Beaconing Pattern"; flow:established,to_server; http.method; content:"GET"; http.uri; pcre:"/^\/(submit\.php\?id=[0-9a-fA-F]{8}|activity|[a-zA-Z0-9]{4})$/"; classtype:trojan-activity; sid:1000004; rev:1;)

# ------------------------------------------------------------------------------
# ATTACK VECTOR 5: Cobalt Strike Default Self-Signed Rogue TLS Certificate
# MITRE ATT&CK: T1587.003 (Develop Capabilities: Digital Certificates)
# OWASP: A04:2025 (Insecure Design)
# Technical Defense:
#   - tls.cert_serial keyword inspects unencrypted TLS Handshake Certificate records (Type 11)
#   - Catches default Cobalt Strike team server certificate serial 08:bb:00:ee (decimal 146473198)
# ------------------------------------------------------------------------------
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-ALERT - Known Cobalt Strike Default TLS Certificate Serial Detected"; flow:established,to_client; tls.cert_serial; content:"08:bb:00:ee"; classtype:trojan-activity; sid:1000005; rev:1;)

# ------------------------------------------------------------------------------
# ATTACK VECTOR 6: DNS Tunneling & Covert Data Exfiltration (High-Entropy Subdomains)
# MITRE ATT&CK: T1048.003 (Exfiltration Over Alternative Protocol: DNS)
# OWASP: A02:2025 (Cryptographic Failures / Sensitive Data Exposure)
# Technical Defense:
#   - Inspects UDP port 53 DNS query buffer (dns.query)
#   - PCRE flags subdomains exceeding 35 characters of encoded alphanumeric payload
# ------------------------------------------------------------------------------
alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-ALERT - Potential DNS Data Exfiltration Tunnel (Long Encoded Subdomain)"; flow:to_server; dns.query; pcre:"/^[a-zA-Z0-9_-]{35,}\./"; classtype:bad-unknown; sid:1000006; rev:1;)
